# === 环境 ===
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# === 数据库 ===
DATABASE_URL=postgresql+asyncpg://bangong:bangong_dev@localhost:5432/bangong
DATABASE_URL_SYNC=postgresql://bangong:bangong_dev@localhost:5432/bangong

# === Qdrant ===
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=bangong_docs

# === Redis ===
REDIS_URL=redis://localhost:6379

# === LLM API Keys ===
ANTHROPIC_API_KEY=sk-ant-xxxxx
OPENAI_API_KEY=sk-xxxxx
DOUBAO_API_KEY=sk-ark-5f506be2-8600-40cb-b132-95aef3df9a24-b3744  # <-- 新增
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3  # <-- 新增

# === LLM 模型配置 ===
DEFAULT_LLM_PROVIDER=doubao  # <-- 改成 doubao 即可默认使用豆包
DEFAULT_LLM_MODEL=doubao-seed-2-0-lite-260428  # <-- 你要的模型
VISION_MODEL=doubao-seed-2-0-lite-260428
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# === ASR / TTS ===
ASR_PROVIDER=whisper
ASR_MODEL=large-v3-turbo
TTS_PROVIDER=edge

# === 文件存储 ===
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# === JWT ===
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# === 可观测 ===
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=